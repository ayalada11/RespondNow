# Server
PORT=3000
AGENT_EMAIL=assistant@yourdomain.com
AGENT_NAME=RespondNow

# OpenAI (for intent detection and response generation)
OPENAI_API_KEY=sk-...

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# Email sending (SMTP - works with Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=assistant@yourdomain.com
SMTP_PASS=

# Inbound email webhook secret (optional, for verifying webhook signatures)
WEBHOOK_SECRET=

# Follow-up settings
FOLLOWUP_DELAY_HOURS=48
MAX_FOLLOWUPS=3

# Working hours (for availability)
WORK_START_HOUR=9
WORK_END_HOUR=17
TIMEZONE=America/New_York
MEETING_DURATION_MINUTES=30
